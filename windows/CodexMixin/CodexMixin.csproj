<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Keep XAML reflection intact; omit development symbols from distribution. -->
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../assets/app_icon.ico')">../assets/app_icon.ico</ApplicationIcon>
    <AssemblyName>codex_mixin_ui</AssemblyName>
    <RootNamespace>CodexMixin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- Self-contained component payloads avoid the all-features Runtime MSIX. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <Compile Include="../Core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Content Include="../build/winsparkle/WinSparkle.dll;../build/winsparkle/WinSparkle.PublicKey.txt;../build/winsparkle/WinSparkle.LICENSE.txt;../build/winsparkle/WinSparkle.Expat.LICENSE.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../scripts/install-update.ps1" Link="install-update.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/*.ico" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/app_icon.png" Link="Assets/app_icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/providers/*.svg" Link="Assets/providers/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/agents/*.svg;../assets/agents/*.png" Link="Assets/agents/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/agents/ATTRIBUTION.md" Link="Assets/agents/ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="FetchWinSparkle" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\fetch-winsparkle.ps1&quot;" />
  </Target>
</Project>
