<Window x:Class="CodexMixin.TrayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ContentControl x:Name="OperationScope" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Border x:Name="Panel" CornerRadius="8" Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="PanelContent" Padding="16,14,16,10" Spacing="10">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Ellipse x:Name="ServiceDot" Width="10" Height="10" Style="{StaticResource DotWarn}" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
       <TextBlock x:Name="ServiceTitle" Text="正在读取服务状态" FontSize="15" FontWeight="SemiBold"/>
       <TextBlock x:Name="Endpoint" Text="" Style="{StaticResource Mono}"/>
      </StackPanel>
      <ToggleSwitch x:Name="GatewaySwitch" Grid.Column="2" OnContent="" OffContent="" Toggled="OnGatewayToggled" MinWidth="0" Width="44" HorizontalAlignment="Right" AutomationProperties.Name="本地网关"/>
     </Grid>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
      <StackPanel x:Name="ProviderStrip" Orientation="Horizontal" Spacing="6"/>
     </ScrollViewer>
     <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
     <!-- The provider strip above names the selection, so no provider header repeats it. -->
     <Grid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ProviderTitle" Text="正在读取服务商…" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      <Border x:Name="QuotaStyleHost" Grid.Column="1" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6" Click="OnRefreshQuota" AutomationProperties.AutomationId="tray-refresh" AutomationProperties.Name="刷新额度" ToolTipService.ToolTip="刷新额度"><FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
     </Grid>
     <StackPanel x:Name="QuotaBody" Spacing="12"/>
     <TextBlock x:Name="QuotaStamp" AutomationProperties.AutomationId="quota-stamp" Style="{StaticResource Caption}" FontSize="11"/>
     <TextBlock x:Name="PanelStatus" AutomationProperties.AutomationId="panel-status" Text="正在读取…" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="11"/>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="1" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6">
    <StackPanel x:Name="PanelMenu" Spacing="0">
     <!-- Models, agents, and usage are pages of the console window. -->
     <Button Style="{StaticResource MenuRow}" Tag="console" Click="OnOpen" AutomationProperties.Name="打开控制台…">
      <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE737;" FontSize="16"/><TextBlock Text="打开控制台…"/></StackPanel>
     </Button>
     <Border Height="1" Margin="10,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
     <Button Style="{StaticResource MenuRow}" AutomationProperties.Name="高级">
      <Grid><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="16"/><TextBlock Text="高级"/></StackPanel><FontIcon Glyph="&#xE76C;" FontSize="12" HorizontalAlignment="Right"/></Grid>
      <Button.Flyout><MenuFlyout Placement="RightEdgeAlignedTop">
       <MenuFlyoutItem Text="Fusion 设置…" Tag="fusion" Click="OnOpen"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
       <MenuFlyoutItem Text="按时间轮转…" Tag="fusion" Click="OnOpen"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE823;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
       <MenuFlyoutSeparator/>
       <MenuFlyoutItem Text="健康检测和修复…" Click="OnDoctor"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
       <MenuFlyoutItem Text="启用网关开机启动" Click="OnAutostart"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
       <MenuFlyoutItem Text="连接、备份与诊断…" Tag="settings" Click="OnOpen"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      </MenuFlyout></Button.Flyout>
     </Button>
     <Button Style="{StaticResource MenuRow}" AutomationProperties.Name="关于">
      <Grid><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="16"/><TextBlock Text="关于"/></StackPanel><FontIcon Glyph="&#xE76C;" FontSize="12" HorizontalAlignment="Right"/></Grid>
      <Button.Flyout><MenuFlyout Placement="RightEdgeAlignedTop">
       <MenuFlyoutItem Text="检查更新…" Tag="updates" Click="OnOpen"/>
       <MenuFlyoutItem Text="关于与日志…" Tag="settings" Click="OnOpen"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      </MenuFlyout></Button.Flyout>
     </Button>
     <Border Height="1" Margin="10,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
     <Button Style="{StaticResource MenuRow}" Tag="quit" Click="OnQuit" AutomationProperties.Name="退出 Codex Mixin">
      <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7E8;" FontSize="16"/><TextBlock Text="退出 Codex Mixin"/></StackPanel>
     </Button>
    </StackPanel>
   </Border>
  </Grid>
 </Border>
 </ContentControl>
</Window>
