<Window x:Class="CodexMixin.TrayWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:CodexMixin"
 Title="Codex Mixin · 主面板" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True" AllowsTransparency="False" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
 <ContentControl x:Name="OperationScope" IsTabStop="False" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
 <Border x:Name="Panel" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}" BorderThickness="1" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <local:Stack x:Name="PanelContent" Padding="16,14,16,10" Spacing="10">
     <local:SpacedGrid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Ellipse x:Name="ServiceDot" Width="10" Height="10" Style="{StaticResource DotWarn}" VerticalAlignment="Center"/>
      <local:Stack Grid.Column="1" Spacing="2" VerticalAlignment="Center">
       <TextBlock x:Name="ServiceTitle" Text="正在读取服务状态" FontSize="15" FontWeight="SemiBold"/>
       <TextBlock x:Name="Endpoint" Text="" Style="{StaticResource Caption}"/>
      </local:Stack>
      <local:ToggleSwitch x:Name="GatewaySwitch" Grid.Column="2" Toggled="OnGatewayToggled" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.AutomationId="GatewaySwitch" AutomationProperties.Name="本地网关"/>
     </local:SpacedGrid>
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <local:Stack x:Name="ProviderStrip" Orientation="Horizontal" Spacing="6"/>
     </ScrollViewer>
     <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
     <!-- The provider strip above names the selection, so no provider header repeats it. -->
     <local:SpacedGrid ColumnSpacing="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ProviderTitle" Text="正在读取服务商…" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      <Border x:Name="QuotaStyleHost" Grid.Column="1" VerticalAlignment="Center"/>
      <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="6" Click="OnRefreshQuota" AutomationProperties.AutomationId="tray-refresh" AutomationProperties.Name="刷新额度" ToolTip="刷新额度"><local:FontIcon Glyph="&#xE72C;" FontSize="14"/></Button>
     </local:SpacedGrid>
     <local:Stack x:Name="QuotaBody" Spacing="12"/>
     <TextBlock x:Name="QuotaStamp" AutomationProperties.AutomationId="quota-stamp" Style="{StaticResource Caption}" FontSize="11"/>
     <TextBlock x:Name="PanelStatus" AutomationProperties.AutomationId="panel-status" Text="正在读取…" TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="11"/>
    </local:Stack>
   </ScrollViewer>
   <Border Grid.Row="1" Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="6">
    <!-- Models, agents, usage, context, and routing are pages of the console window. -->
    <local:SpacedGrid x:Name="PanelMenu" ColumnSpacing="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Style="{StaticResource MenuRow}" Tag="console" Click="OnOpen" AutomationProperties.Name="打开控制台…">
      <local:Stack Orientation="Horizontal" Spacing="10"><local:FontIcon Glyph="&#xE737;"/><TextBlock Text="打开控制台…"/></local:Stack>
     </Button>
     <Button x:Name="AdvancedRow" Grid.Column="1" Style="{StaticResource FlatButton}" Padding="9" AutomationProperties.Name="高级" ToolTip="高级">
      <local:FontIcon Glyph="&#xE713;"/>
      <Button.ContextMenu><ContextMenu>
       <MenuItem Header="模型路由…" Tag="routing" Click="OnOpen"><MenuItem.Icon><local:FontIcon Glyph="&#xE8F1;" FontSize="14"/></MenuItem.Icon></MenuItem>
       <Separator/>
       <MenuItem Header="健康检测和修复…" Click="OnDoctor"><MenuItem.Icon><local:FontIcon Glyph="&#xE9D9;" FontSize="14"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="启用网关开机启动" Click="OnAutostart"><MenuItem.Icon><local:FontIcon Glyph="&#xE7E8;" FontSize="14"/></MenuItem.Icon></MenuItem>
       <MenuItem Header="连接、备份与诊断…" Tag="settings" Click="OnOpen"><MenuItem.Icon><local:FontIcon Glyph="&#xE713;" FontSize="14"/></MenuItem.Icon></MenuItem>
      </ContextMenu></Button.ContextMenu>
     </Button>
     <Button x:Name="AboutRow" Grid.Column="2" Style="{StaticResource FlatButton}" Padding="9" AutomationProperties.Name="关于" ToolTip="关于">
      <local:FontIcon Glyph="&#xE946;"/>
      <Button.ContextMenu><ContextMenu>
       <MenuItem Header="检查更新…" Tag="updates" Click="OnOpen"/>
       <MenuItem Header="关于与日志…" Tag="settings" Click="OnOpen"><MenuItem.Icon><local:FontIcon Glyph="&#xE946;" FontSize="14"/></MenuItem.Icon></MenuItem>
      </ContextMenu></Button.ContextMenu>
     </Button>
     <Button Grid.Column="3" Style="{StaticResource FlatButton}" Padding="9" Tag="lightweight" Click="OnLightweight" AutomationProperties.Name="轻量模式" ToolTip="轻量模式">
      <local:FontIcon Glyph="&#xE708;"/>
     </Button>
     <Button Grid.Column="4" Style="{StaticResource FlatButton}" Padding="9" Tag="quit" Click="OnQuit" AutomationProperties.Name="彻底退出 Mixin" ToolTip="彻底退出 Mixin">
      <local:FontIcon Glyph="&#xE7E8;"/>
     </Button>
    </local:SpacedGrid>
   </Border>
  </Grid>
 </Border>
 </ContentControl>
</Window>
