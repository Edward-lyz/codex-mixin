<Window x:Class="CodexMixin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:CodexMixin"
    Title="Codex Mixin" Icon="pack://siteoforigin:,,,/Assets/app_icon.png"
    MinWidth="760" MinHeight="560">
 <!-- Content extends into the title bar; the Fluent theme supplies Mica behind it on Windows 11. -->
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="True"/>
 </WindowChrome.WindowChrome>
 <ContentControl x:Name="OperationScope" IsTabStop="False" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
      <Image Source="pack://siteoforigin:,,,/Assets/app_icon.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Codex Mixin" Margin="12,0,0,0" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid x:Name="NavPane" Grid.Row="1" Grid.ColumnSpan="2" Margin="16,4,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TabControl x:Name="ConsoleTabs" HorizontalAlignment="Center" Style="{StaticResource NavTabs}" ItemContainerStyle="{StaticResource NavTab}" SelectionChanged="OnConsoleTab" AutomationProperties.AutomationId="console-pages">
        <TabItem Header="模型与服务" Tag="providers" AutomationProperties.AutomationId="console-providers-tab"/>
        <TabItem Header="Agent 接入" Tag="agents" AutomationProperties.AutomationId="console-agents-tab"/>
        <TabItem Header="用量明细" Tag="usage" AutomationProperties.AutomationId="console-usage-tab"/>
        <TabItem Header="上下文" Tag="context" AutomationProperties.AutomationId="console-context-tab"/>
        <TabItem Header="模型路由" Tag="routing" AutomationProperties.AutomationId="console-routing-tab"/>
      </TabControl>
      <Button Grid.Column="1" Style="{StaticResource NavButton}" Tag="settings" Click="OnNavButton" AutomationProperties.Name="设置与诊断">
        <StackPanel Orientation="Horizontal"><local:FontIcon Glyph="&#xE713;"/><TextBlock x:Name="SettingsLabel" Text="设置与诊断" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel>
      </Button>
    </Grid>
    <ContentControl x:Name="PageShell" Grid.Row="2" Grid.ColumnSpan="2" IsTabStop="False" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <Border x:Name="ContentLayer" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="264"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="ProviderSidebar" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
          <local:SpacedGrid Margin="8,20,8,12" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <local:SpacedGrid Margin="12,0,0,0" ColumnSpacing="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="服务商" Style="{DynamicResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Style="{StaticResource FlatButton}" Padding="8" Click="OnAddProvider" AutomationProperties.Name="新增服务商" ToolTip="新增服务商"><local:FontIcon Glyph="&#xE710;" FontSize="14"/></Button>
              <Button Grid.Column="2" Style="{StaticResource FlatButton}" Padding="8" Click="OnRemoveProvider" AutomationProperties.Name="删除服务商" ToolTip="删除服务商"><local:FontIcon Glyph="&#xE738;" FontSize="14"/></Button>
            </local:SpacedGrid>
            <local:VirtualList x:Name="ProviderList" Grid.Row="1" SelectionMode="Single" BorderThickness="0" Background="Transparent" SelectionChanged="OnProviderSelected" AutomationProperties.AutomationId="provider-list"/>
          </local:SpacedGrid>
        </Border>
        <local:SpacedGrid x:Name="PageLayout" Grid.Column="1" Margin="32,24,32,16" RowSpacing="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <local:SpacedGrid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <local:SpacedGrid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="ProviderHeaderTile" Style="{StaticResource IconTile}" Width="44" Height="44" Visibility="Collapsed">
                <ContentControl x:Name="ProviderHeaderIcon" Width="28" Height="28" IsTabStop="False" Focusable="False"/>
              </Border>
              <local:Stack Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="PageTitle" Text="模型与服务" Style="{DynamicResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border x:Name="StatusBadge" Style="{StaticResource SuccessBadge}" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold"/></Border>
                <Border x:Name="OfficialBadge" Visibility="Collapsed" Style="{StaticResource SuccessBadge}" VerticalAlignment="Center"><TextBlock Text="官方" FontSize="11" FontWeight="SemiBold"/></Border>
              </local:Stack>
            </local:SpacedGrid>
            <local:Stack Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TabControl x:Name="ProviderTabs" Style="{StaticResource PivotTabs}" ItemContainerStyle="{StaticResource PivotTab}" Margin="0,0,12,0" VerticalAlignment="Center" SelectionChanged="OnProviderTab">
                <TabItem x:Name="ModelsTab" Header="模型" AutomationProperties.AutomationId="provider-models-tab"/>
                <TabItem x:Name="ConnectionTab" Header="连接设置" AutomationProperties.AutomationId="provider-connection-tab"/>
              </TabControl>
              <Button Style="{StaticResource FlatButton}" Padding="8" Click="OnRefresh" AutomationProperties.Name="刷新" ToolTip="刷新 (Ctrl+R)"><local:FontIcon Glyph="&#xE72C;" FontSize="15"/></Button>
              <Button x:Name="WindowMenu" Style="{StaticResource FlatButton}" Padding="8" AutomationProperties.AutomationId="window-menu" AutomationProperties.Name="更多窗口" ToolTip="更多窗口">
                <local:FontIcon Glyph="&#xE712;" FontSize="15"/>
              </Button>
            </local:Stack>
          </local:SpacedGrid>
          <local:InfoBar x:Name="Notice" Grid.Row="1" IsClosable="True"/>
          <ScrollViewer x:Name="PageScroll" Grid.Row="2" AutomationProperties.AutomationId="page-scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="PageBodyHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          </ScrollViewer>
          <local:SpacedGrid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="DraftSummary" Text="未修改" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="draft-summary" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="ApplyChanges" Grid.Column="1" Content="应用更改" MinWidth="96" Style="{DynamicResource AccentButtonStyle}" Click="OnApplyChanges" AutomationProperties.AutomationId="apply-changes"/>
          </local:SpacedGrid>
        </local:SpacedGrid>
      </Grid>
      </Border>
    </ContentControl>
    <Border x:Name="StatusLayer" Grid.Row="3" Grid.ColumnSpan="2" Padding="16,6" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
      <local:SpacedGrid ColumnSpacing="10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <local:ProgressRing x:Name="Activity" Width="14" Height="14" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="operation-status" AutomationProperties.LiveSetting="Polite" Grid.Column="1" Text="正在连接 CLI…" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button x:Name="OutputDetails" Content="操作详情" Style="{StaticResource LinkButton}" Padding="6,2" Visibility="Collapsed" Click="OnOutputDetails"/>
        <Button x:Name="CancelAction" Content="取消操作" Style="{StaticResource LinkButton}" Padding="6,2" Visibility="Collapsed" Click="OnCancel"/>
        </StackPanel>
      </local:SpacedGrid>
    </Border>
  </Grid>
 </ContentControl>
</Window>
